# SlotBack Environment Configuration Template
# Duplicate this file to .env and configure values before starting the application.

# Application Core
APP_NAME=SlotBack API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Security & Authentication (Generate min 32-char high-entropy string for production)
SECRET_KEY=slotback-insecure-dev-secret-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
INITIAL_ADMIN_EMAIL=admin@gmail.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-secret

# Database Connections
DATABASE_URL=postgresql+psycopg://slotback:slotback_dev_password@localhost:5432/slotback
TEST_DATABASE_URL=postgresql+psycopg://slotback:slotback_dev_password@localhost:5432/slotback_test

# Cross-Origin Resource Sharing (Explicit URLs, never '*' in production)
CORS_ORIGINS=http://localhost:5173

# Notification / Email Provider (Leave blank for dev structured console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@slotback.com
